# =============================================================
# InboxZero — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================

# ----------------------------
# Database (PostgreSQL)
# ----------------------------
# Use a random hexadecimal password (URL-safe); Compose uses it internally.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
# Only used outside Docker. Match the password above.
DATABASE_URL=postgresql://inboxzero:REPLACE_WITH_RANDOM_HEX_PASSWORD@localhost:5432/inboxzero

# ----------------------------
# API Server
# ----------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Required by API configuration (inbox access uses generated hashed secrets).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# Secret for the internal mail ingestion endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGESTION_API_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# ----------------------------
# Email Domain Configuration
# ----------------------------
# Reserved development-only defaults. These cannot receive public Internet mail.
WORK_EMAIL_DOMAIN=work.inboxzero.test
SCHOOL_EMAIL_DOMAIN=school.inboxzero.test
PERSONAL_EMAIL_DOMAIN=inboxzero.test
CUSTOM_USERNAMES_ENABLED=true
# Required in production: comma-separated root domains that you own/control.
# Every category and legacy domain must equal or be below an owned root.
OWNED_MAIL_DOMAINS=
# Optional legacy API domain allowlist. It does not choose category domains.
MAIL_DOMAINS=inboxzero.test

# ----------------------------
# Inbox Lifecycle
# ----------------------------
# Inbox lifetime in minutes (default: 60)
INBOX_TTL_MINUTES=60

# Maximum messages per inbox
MAX_MESSAGES_PER_INBOX=50

# Maximum message size in bytes (default: 1MB)
MAX_MESSAGE_SIZE_BYTES=1048576
CLEANUP_INTERVAL_MS=60000

# ----------------------------
# Rate Limiting
# ----------------------------
# Max inbox creations per IP per hour
RATE_LIMIT_INBOX_CREATE_PER_HOUR=10

# Max API requests per IP per minute
RATE_LIMIT_API_PER_MINUTE=60

# Trust proxy headers (set true behind nginx/Caddy)
TRUST_PROXY=false

# ----------------------------
# Frontend
# ----------------------------
# Browser API requests use same-origin /api paths.
# In development, Vite proxies /api to the local API server.

# Link to source repository
VITE_GITHUB_URL=https://github.com/your-org/inboxzero

# ----------------------------
# CORS
# ----------------------------
# Allowed origin for browser requests
CORS_ORIGIN=http://localhost:5173
